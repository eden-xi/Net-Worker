{
    "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
    "manifestVersion": "1.17",
    "version": "1.0.0",
    "id": "{{TEAMS_APP_ID}}",
    "developer": {
        "name": "{{COMPANY_NAME}}",
        "websiteUrl": "https://{{HOSTNAME}}",
        "privacyUrl": "https://{{HOSTNAME}}",
        "termsOfUseUrl": "https://{{HOSTNAME}}"
    },
    "name": {
        "short": "ProjectHub",
        "full": "ProjectHub internal project marketplace"
    },
    "description": {
        "short": "Find internal projects that match your skills.",
        "full": "Browse open internal projects, get recommendations based on your skills and resume, and apply. Project managers post projects and review applicants ranked by match."
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "accentColor": "#7A1FC9",
    "staticTabs": [
        {
            "entityId": "projecthub",
            "name": "ProjectHub",
            "contentUrl": "https://{{HOSTNAME}}/?inTeams=1#/browse",
            "websiteUrl": "https://{{HOSTNAME}}/#/browse",
            "scopes": ["personal"]
        },
        {
            "entityId": "about",
            "scopes": ["personal"]
        }
    ],
    "permissions": ["identity"],
    "validDomains": ["{{HOSTNAME}}"],
    "webApplicationInfo": {
        "id": "{{ENTRA_CLIENT_ID}}",
        "resource": "api://{{HOSTNAME}}/{{ENTRA_CLIENT_ID}}"
    }
}
